{
    "name": "phasync/server",
    "description": "A high performance async TCP and UDP socket server for PHP.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "phasync\\Net\\": "src/Net/"
        }
    },
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frode@ennerd.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "phasync/phasync": "^2.0@alpha"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
